# ═══════════════════════════════════════════════════════════════════
#  .env configuration for LEGO Configurator
# ═══════════════════════════════════════════════════════════════════

# PostgreSQL Database URL (розкоментуйте коли PostgreSQL встановлено)
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lego_configurator

# SQLite — працює без додаткових налаштувань (за замовчуванням)
# Якщо DATABASE_URL не встановлено, система використовує SQLite автоматично

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_EXPIRE_DAYS=1
