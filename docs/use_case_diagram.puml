@startuml UseCase_LEGO_Configurator
' ============================================================
'  UML Use Case Diagram — LEGO Robot Configurator
'  Вибір режиму генерації (Greedy / Genetic)
'  та налаштування ваг критеріїв
' ============================================================

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

skinparam usecase {
    BackgroundColor #FEFECE
    BorderColor #A80036
    ArrowColor #A80036
}

skinparam rectangle {
    BackgroundColor #F1F1F1
    BorderColor #333333
}

' ── Актори ──
actor "Користувач" as User
actor "Система\n(Backend API)" as System

' ── Межа системи ──
rectangle "LEGO Robot Configurator" {

    ' ── Група: Формування запиту ──
    usecase "Заповнити форму\nконфігурації" as UC_Form
    usecase "Вказати функції робота\n(drive, arm, sense …)" as UC_Functions
    usecase "Задати бюджет\nта максимальну вагу" as UC_Budget
    usecase "Обрати набір сенсорів" as UC_Sensors
    usecase "Вказати тип місцевості\n(indoor / outdoor / offroad)" as UC_Terrain
    usecase "Увімкнути Eco-режим" as UC_Eco

    ' ── Група: Вибір режиму генерації ──
    usecase "Обрати режим генерації" as UC_Mode
    usecase "Greedy (жадібний)\nалгоритм" as UC_Greedy
    usecase "Genetic (генетичний)\nалгоритм" as UC_Genetic

    ' ── Група: Налаштування ваг критеріїв ──
    usecase "Налаштувати ваги\nкритеріїв (WSM)" as UC_Weights
    usecase "Встановити вагу\n«Швидкість» (speed)" as UC_W_Speed
    usecase "Встановити вагу\n«Сила» (force)" as UC_W_Force
    usecase "Встановити вагу\n«Економія» (economy)" as UC_W_Economy
    usecase "Встановити вагу\n«Витривалість» (endurance)" as UC_W_Endurance
    usecase "Встановити вагу\n«Еко» (eco)" as UC_W_Eco

    ' ── Група: Генерація та результат ──
    usecase "Згенерувати\nконфігурацію" as UC_Generate
    usecase "Відобразити прогрес\n(SSE-потік)" as UC_Progress
    usecase "Отримати результат\nконфігурації" as UC_Result
    usecase "Зберегти конфігурацію\nв базу даних" as UC_Save

    ' ── Група: Аналітика ──
    usecase "Переглянути порівняльний\nаналіз алгоритмів" as UC_Analytics
    usecase "Переглянути історію\nконфігурацій" as UC_History

    ' ── Група: Автентифікація ──
    usecase "Увійти в систему\n(Sign In)" as UC_Auth
}

' ══════════════════════════════════
'   Зв'язки Користувача
' ══════════════════════════════════

User --> UC_Form
User --> UC_Mode
User --> UC_Weights
User --> UC_Generate
User --> UC_Analytics
User --> UC_History
User --> UC_Auth

' ══════════════════════════════════
'   Зв'язки Системи
' ══════════════════════════════════

UC_Generate --> System
UC_Save --> System
UC_Progress --> System
UC_Analytics --> System

' ══════════════════════════════════
'   <<include>> — обов'язкові кроки
' ══════════════════════════════════

UC_Form ..> UC_Functions  : <<include>>
UC_Form ..> UC_Budget     : <<include>>

UC_Generate ..> UC_Mode   : <<include>>
UC_Generate ..> UC_Result : <<include>>
UC_Generate ..> UC_Save   : <<include>>

' ══════════════════════════════════
'   <<extend>> — необов'язкові кроки
' ══════════════════════════════════

UC_Form <.. UC_Sensors    : <<extend>>
UC_Form <.. UC_Terrain    : <<extend>>
UC_Form <.. UC_Eco        : <<extend>>
UC_Form <.. UC_Weights    : <<extend>>

' Режими генерації — спеціалізація UC_Mode
UC_Mode <|-- UC_Greedy
UC_Mode <|-- UC_Genetic

' Прогрес тільки для Genetic
UC_Genetic ..> UC_Progress : <<include>>

' Ваги — деталізація
UC_Weights ..> UC_W_Speed     : <<include>>
UC_Weights ..> UC_W_Force     : <<include>>
UC_Weights ..> UC_W_Economy   : <<include>>
UC_Weights ..> UC_W_Endurance : <<include>>
UC_Weights ..> UC_W_Eco       : <<include>>

' ══════════════════════════════════
'   Примітки
' ══════════════════════════════════

note right of UC_Greedy
  Послідовний жадібний підхід.
  Обирає найкращий компонент
  на кожному кроці за зваженою
  оцінкою (WSM).
  Складність: O(n·k)
end note

note right of UC_Genetic
  Еволюційна оптимізація.
  Context-Aware: враховує
  контекст функції робота.
  Параметри: population=200,
  generations=300, mutation=0.08.
  Повертає SSE-потік прогресу.
end note

note bottom of UC_Weights
  Weighted Sum Model (WSM):
  TotalScore = Σ (norm_i × w_i)
  5 критеріїв: speed, force,
  economy, endurance, eco.
  Кожна вага ∈ [0.0 … 1.0]
end note

@enduml
