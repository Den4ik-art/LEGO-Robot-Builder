@startuml GoalTree_LEGO_Configurator
' ============================================================
'  Дерево цілей системи «LEGO Robot Configurator»
'  Рисунок 2.1 — AS-TO-BE
' ============================================================

top to bottom direction
skinparam defaultTextAlignment center
skinparam wrapWidth 200

skinparam rectangle {
    RoundCorner 15
}

' ─── Кольорова палітра ───
skinparam rectangle<<root>> {
    BackgroundColor #1A237E
    FontColor #FFFFFF
    BorderColor #0D47A1
    FontSize 14
    FontStyle bold
}

skinparam rectangle<<L1>> {
    BackgroundColor #283593
    FontColor #FFFFFF
    BorderColor #1565C0
    FontSize 12
}

skinparam rectangle<<L2>> {
    BackgroundColor #42A5F5
    FontColor #FFFFFF
    BorderColor #1E88E5
    FontSize 11
}

skinparam rectangle<<L3>> {
    BackgroundColor #90CAF9
    FontColor #1A237E
    BorderColor #64B5F6
    FontSize 10
}

skinparam rectangle<<module>> {
    BackgroundColor #E3F2FD
    FontColor #0D47A1
    BorderColor #90CAF9
    FontSize 9
    FontStyle italic
}

' ═══════════════════════════════════════════════════════════════
'  РІВЕНЬ 0 — ГЛОБАЛЬНА МЕТА
' ═══════════════════════════════════════════════════════════════

rectangle "**Г0:** Забезпечити автоматизовану генерацію\nструктурно валідних та оптимізованих\nконфігурацій роботів\nіз можливістю вибору стратегії пошуку" as G0 <<root>>

' ═══════════════════════════════════════════════════════════════
'  РІВЕНЬ 1 — ПІДЦІЛІ
' ═══════════════════════════════════════════════════════════════

rectangle "**Г1:** Забезпечити\nбагатокритеріальну\nгнучкість оцінювання" as G1 <<L1>>

rectangle "**Г2:** Гарантувати\nструктурну валідність\nконфігурацій" as G2 <<L1>>

rectangle "**Г3:** Реалізувати\nальтернативні стратегії\nпошуку рішень" as G3 <<L1>>

rectangle "**Г4:** Забезпечити\nадаптивність до\nсередовища розгортання" as G4 <<L1>>

G0 --> G1
G0 --> G2
G0 --> G3
G0 --> G4

' ═══════════════════════════════════════════════════════════════
'  РІВЕНЬ 2 — ПІДЦІЛІ Г1 (Багатокритеріальна гнучкість)
' ═══════════════════════════════════════════════════════════════

rectangle "**Г1.1:** Реалізувати\nMin-Max нормалізацію\n5 критеріїв" as G1_1 <<L2>>

rectangle "**Г1.2:** Забезпечити\nкористувацьке керування\nвагами критеріїв" as G1_2 <<L2>>

rectangle "**Г1.3:** Реалізувати\nрежим Eco-Mode\n(зниження енергоспоживання)" as G1_3 <<L2>>

G1 --> G1_1
G1 --> G1_2
G1 --> G1_3

' ═══════════════════════════════════════════════════════════════
'  РІВЕНЬ 2 — ПІДЦІЛІ Г2 (Структурна валідність)
' ═══════════════════════════════════════════════════════════════

rectangle "**Г2.1:** Впровадити\nправило Base-First\n(обов'язкова база)" as G2_1 <<L2>>

rectangle "**Г2.2:** Реалізувати\nперевірку портів\nта балансу живлення" as G2_2 <<L2>>

rectangle "**Г2.3:** Забезпечити\nсиметрію приводу\n(парність коліс/моторів)" as G2_3 <<L2>>

rectangle "**Г2.4:** Реалізувати\nпрофілі складності\n(рівні 1–5)" as G2_4 <<L2>>

G2 --> G2_1
G2 --> G2_2
G2 --> G2_3
G2 --> G2_4

' ═══════════════════════════════════════════════════════════════
'  РІВЕНЬ 2 — ПІДЦІЛІ Г3 (Стратегії пошуку)
' ═══════════════════════════════════════════════════════════════

rectangle "**Г3.1:** Реалізувати\nGreedy-алгоритм\n(послотова збірка)" as G3_1 <<L2>>

rectangle "**Г3.2:** Реалізувати\nGenetic-алгоритм\n(еволюційна оптимізація)" as G3_2 <<L2>>

rectangle "**Г3.3:** Забезпечити\nпорівняльний аналіз\nалгоритмів (benchmarking)" as G3_3 <<L2>>

G3 --> G3_1
G3 --> G3_2
G3 --> G3_3

' ═══════════════════════════════════════════════════════════════
'  РІВЕНЬ 2 — ПІДЦІЛІ Г4 (Адаптивність)
' ═══════════════════════════════════════════════════════════════

rectangle "**Г4.1:** Реалізувати\nпідтримку PostgreSQL\n(production)" as G4_1 <<L2>>

rectangle "**Г4.2:** Реалізувати\nавтоматичний fallback\nна SQLite (portable)" as G4_2 <<L2>>

rectangle "**Г4.3:** Впровадити\nlazy initialization\nдля БД" as G4_3 <<L2>>

G4 --> G4_1
G4 --> G4_2
G4 --> G4_3

' ═══════════════════════════════════════════════════════════════
'  РІВЕНЬ 3 — ДЕТАЛІЗАЦІЯ (Ключові підцілі)
' ═══════════════════════════════════════════════════════════════

rectangle "Критерії:\nspeed, force,\neconomy, endurance, eco" as G1_1_d <<L3>>
G1_1 --> G1_1_d

rectangle "Слайдери ваг\nу формі конфігурації\n(PriorityWeights DTO)" as G1_2_d <<L3>>
G1_2 --> G1_2_d

rectangle "8 послідовних слотів:\nBase → Hub → Power →\nDrive → Functions →\nSensors → Structure →\nAccessories" as G3_1_d <<L3>>
G3_1 --> G3_1_d

rectangle "Context-Aware:\nдоменна фільтрація,\nремонт геному\n(_repair_integrity),\nSSE-прогрес" as G3_2_d <<L3>>
G3_2 --> G3_2_d

rectangle "Автоматичне\nвизначення наявності\npsycopg2-драйвера" as G4_2_d <<L3>>
G4_2 --> G4_2_d

' ═══════════════════════════════════════════════════════════════
'  МОДУЛІ-ВИКОНАВЦІ (нижній рівень)
' ═══════════════════════════════════════════════════════════════

rectangle "normalization.py\nscoring.py" as M1 <<module>>
rectangle "constraints.py" as M2 <<module>>
rectangle "greedy.py\nsequential.py" as M3 <<module>>
rectangle "genetic.py" as M4 <<module>>
rectangle "database.py" as M5 <<module>>
rectangle "analytics.py\nbenchmark.py" as M6 <<module>>

G1_1_d --> M1
G2_1 --> M2
G2_2 --> M2
G2_3 --> M2
G2_4 --> M2
G3_1_d --> M3
G3_2_d --> M4
G4_2_d --> M5
G4_1 --> M5
G4_3 --> M5
G3_3 --> M6

' ═══════════════════════════════════════════════════════════════
'  ЛЕГЕНДА
' ═══════════════════════════════════════════════════════════════

legend right
  |= Колір |= Рівень |
  | <#1A237E> | Глобальна мета (Г0) |
  | <#283593> | Підцілі 1-го рівня (Г1–Г4) |
  | <#42A5F5> | Підцілі 2-го рівня |
  | <#90CAF9> | Деталізація (рівень 3) |
  | <#E3F2FD> | Модулі-виконавці |
endlegend

@enduml
